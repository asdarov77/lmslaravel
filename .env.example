APP_NAME=LMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
VITE_APP_URL=http://127.0.0.1:8000
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lms
DB_USERNAME=lms
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
# Очередь обязана быть настоящей, а не sync. При sync задача генерации
# выполняется внутри HTTP-запроса «начать тренировку»: запрос держится
# десятки секунд и упирается в клиентский таймаут (воспроизведено:
# alert «timeout of 60000ms exceeded», вопросы при этом генерируются).
# Запуск воркера: php artisan queue:work
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

FILESYSTEM_DRIVER=public

# --- Тренажёр (локальная генерация вопросов по материалам курсов) -----
# По умолчанию выключен: генерацию включает методист в настройках.
# Флаг ниже — запасной вариант для развёртываний без настроек в базе.
TUTOR_ENABLED=false
TUTOR_PROVIDER=ollama
TUTOR_OLLAMA_URL=http://127.0.0.1:11434
# Модель обязана быть установлена: ollama pull <имя>.
# qwen3:4b (~2.5 ГБ, thinking=false) — дефолт для обычных CPU-машин.
# qwen2.5:3b — вариант для слабых ПК. Ниже 3B тренажёр выдаёт либо пусто,
# либо смыслово неверные вопросы: замеры в config/tutor.php.
TUTOR_MODEL=qwen3:4b
# У qwen3/qwen3.5 «размышление» съедает весь бюджет токенов и даёт
# пустой ответ. Не выключать без проверки на своей модели.
TUTOR_DISABLE_THINKING=true
TUTOR_EMBED_MODEL=multilingual-e5-small

# Вариант A: Python-сателлит с ChromaDB (векторный поиск, коллекция на
# курс). Пусто = Вариант B, полнотекстовый поиск Postgres без Python.
TUTOR_SATELLITE_URL=
TUTOR_SATELLITE_TIMEOUT=60
TUTOR_TEMPERATURE=0.4
TUTOR_TIMEOUT=180
TUTOR_MAX_CHUNK_CHARS=2000
TUTOR_CHUNK_OVERLAP_CHARS=300
TUTOR_MAX_CHUNKS_PER_JOB=4
# Выключено по умолчанию: на слабых моделях back-check стоит второго
# вызова на каждый вопрос и даёт шум. Основную защиту несут
# детерминированные проверки (цитата ищется во фрагменте дословно).
TUTOR_BACKCHECK=false
TUTOR_BATCH_SIZE=8
TUTOR_MAX_TOKENS=700
TUTOR_TOKENS_PER_QUESTION=110
TUTOR_BACKCHECK_TOKENS=300

# Каталог материала курсов (АУК).
#
# Не задавайте путь внутри storage/app/public: `php artisan storage:link`
# создаёт public/storage -> storage/app/public, и материал оттуда
# отдаётся по адресу /storage/private/... БЕЗ проверки HMAC-подписи.
#
# Умолчание — storage/app/courses/private. Задать имеет смысл, если
# контент лежит на отдельном томе. Порядок при смене пути:
#   1. php artisan content:relocate --to=<новый путь>
#   2. прописать COURSES_PATH здесь
#   3. php artisan content:nginx-config и обновить alias в nginx
#   4. php artisan content:check-exposure
#COURSES_PATH=/var/lib/lms/courses/private/
