<template>
  <div class="styleguide-section">
    <h2 class="styleguide-section__title">{{ $t("styleguide.spacing.title") }}</h2>
    <p class="styleguide-section__desc">{{ $t("styleguide.spacing.desc") }}</p>

    <h3 class="styleguide__group-title">{{ $t("styleguide.spacing.scaleTitle") }}</h3>
    <div class="styleguide__spacing-scale">
      <div
        v-for="item in spacingScale"
        :key="item.name"
        class="styleguide__spacing-item"
      >
        <div class="styleguide__spacing-visual" :style="{ height: item.value }"></div>
        <div class="styleguide__spacing-info">
          <code class="styleguide__spacing-token">{{ item.token }}</code>
          <code class="styleguide__spacing-value">{{ item.value }}</code>
        </div>
      </div>
    </div>

    <h3 class="styleguide__group-title" style="margin-top: var(--sp-8);">{{ $t("styleguide.spacing.radiusTitle") }}</h3>
    <div class="styleguide__radius-scale">
      <div
        v-for="item in radiusScale"
        :key="item.name"
        class="styleguide__radius-item"
      >
        <div class="styleguide__radius-visual" :style="{ borderRadius: item.value }"></div>
        <div class="styleguide__radius-info">
          <code class="styleguide__radius-token">{{ item.token }}</code>
          <code class="styleguide__radius-value">{{ item.value }}</code>
        </div>
      </div>
    </div>

    <h3 class="styleguide__group-title" style="margin-top: var(--sp-8);">{{ $t("styleguide.spacing.shadowsTitle") }}</h3>
    <div class="styleguide__shadow-scale">
      <div
        v-for="item in shadowScale"
        :key="item.name"
        class="styleguide__shadow-item"
      >
        <div class="styleguide__shadow-visual" :style="{ boxShadow: item.value }"></div>
        <div class="styleguide__shadow-info">
          <code class="styleguide__shadow-token">{{ item.token }}</code>
          <code class="styleguide__shadow-value">{{ item.value }}</code>
        </div>
      </div>
    </div>

    <h3 class="styleguide__group-title" style="margin-top: var(--sp-8);">{{ $t("styleguide.spacing.zIndexTitle") }}</h3>
    <div class="styleguide__zindex-scale">
      <div
        v-for="item in zIndexScale"
        :key="item.name"
        class="styleguide__zindex-item"
      >
        <div class="styleguide__zindex-visual" :style="{ zIndex: item.value }"></div>
        <div class="styleguide__zindex-info">
          <code class="styleguide__zindex-token">{{ item.token }}</code>
          <code class="styleguide__zindex-value">{{ item.value }}</code>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import { computed } from "vue"
import { useI18n } from "vue-i18n"

export default {
  name: "StyleguideSpacing",

  setup() {
    const { t } = useI18n()

    const spacingScale = computed(() => {
      const base = [
        { token: "--sp-1", value: "var(--sp-1)" },
        { token: "--sp-2", value: "var(--sp-2)" },
        { token: "--sp-3", value: "var(--sp-3)" },
        { token: "--sp-4", value: "var(--sp-4)" },
        { token: "--sp-5", value: "var(--sp-5)" },
        { token: "--sp-6", value: "var(--sp-6)" },
        { token: "--sp-8", value: "var(--sp-8)" },
        { token: "--sp-10", value: "var(--sp-10)" },
        { token: "--sp-12", value: "var(--sp-12)" },
        { token: "--sp-16", value: "var(--sp-16)" },
      ]
      return base.map((s, i) => ({ ...s, name: "sp-" + (i + 1) }))
    })

    const radiusScale = computed(() => {
      const base = [
        { token: "--c-radius-sm", value: "var(--c-radius-sm)" },
        { token: "--c-radius-md", value: "var(--c-radius-md)" },
        { token: "--c-radius-lg", value: "var(--c-radius-lg)" },
        { token: "--c-radius-xl", value: "var(--c-radius-xl)" },
        { token: "--c-radius-full", value: "var(--c-radius-full)" },
      ]
      return base.map((r, i) => ({ ...r, name: "radius-" + (i + 1) }))
    })

    const shadowScale = computed(() => {
      const base = [
        { token: "--shadow-1", value: "var(--shadow-1)" },
        { token: "--shadow-2", value: "var(--shadow-2)" },
        { token: "--shadow-3", value: "var(--shadow-3)" },
        { token: "--shadow-4", value: "var(--shadow-4)" },
        { token: "--shadow-5", value: "var(--shadow-5)" },
        { token: "--shadow-glow", value: "var(--shadow-glow)" },
      ]
      return base.map((s, i) => ({ ...s, name: "shadow-" + (i + 1) }))
    })

    const zIndexScale = computed(() => {
      const base = [
        { token: "--z-base", value: "var(--z-base)" },
        { token: "--z-sticky", value: "var(--z-sticky)" },
        { token: "--z-dropdown", value: "var(--z-dropdown)" },
        { token: "--z-overlay", value: "var(--z-overlay)" },
        { token: "--z-toast", value: "var(--z-toast)" },
      ]
      return base.map((z, i) => ({ ...z, name: "z-" + (i + 1) }))
    })

    return { spacingScale, radiusScale, shadowScale, zIndexScale }
  },
}
</script>

<style scoped>
.styleguide__spacing-scale {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}

.styleguide__spacing-item {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  padding: var(--sp-3);
  background: var(--c-surface);
  border: 1px solid var(--c-border);
  border-radius: var(--c-radius-md);
}

.styleguide__spacing-visual {
  width: 60px;
  background: var(--c-primary);
  border-radius: var(--c-radius-sm);
  flex-shrink: 0;
}

.styleguide__spacing-info {
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
}

.styleguide__spacing-token {
  font-size: var(--fs-sm);
  color: var(--c-primary);
  font-family: var(--font-mono);
}

.styleguide__spacing-value {
  font-size: var(--fs-sm);
  color: var(--c-text-secondary);
  font-family: var(--font-mono);
}

.styleguide__radius-scale,
.styleguide__shadow-scale,
.styleguide__zindex-scale {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}

.styleguide__radius-item,
.styleguide__shadow-item,
.styleguide__zindex-item {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  padding: var(--sp-3);
  background: var(--c-surface);
  border: 1px solid var(--c-border);
  border-radius: var(--c-radius-md);
}

.styleguide__radius-visual {
  width: 80px;
  height: 40px;
  background: var(--c-primary-soft);
  border: 1px solid var(--c-border);
  flex-shrink: 0;
}

.styleguide__shadow-visual {
  width: 120px;
  height: 40px;
  background: var(--c-surface);
  border: 1px solid var(--c-border),
  flex-shrink: 0;
}

.styleguide__zindex-visual {
  width: 80px;
  height: 30px;
  background: var(--c-primary-soft);
  border: 1px solid var(--c-border);
  flex-shrink: 0;
}

.styleguide__radius-info,
.styleguide__shadow-info,
.styleguide__zindex-info {
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
}

.styleguide__radius-token,
.styleguide__shadow-token,
.styleguide__zindex-token {
  font-size: var(--fs-sm);
  color: var(--c-primary);
  font-family: var(--font-mono);
}

.styleguide__radius-value,
.styleguide__shadow-value,
.styleguide__zindex-value {
  font-size: var(--fs-sm);
  color: var(--c-text-secondary);
  font-family: var(--font-mono);
}
</style>