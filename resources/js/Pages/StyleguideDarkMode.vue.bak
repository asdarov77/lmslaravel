<template>
  <div class="styleguide-section">
    <h2 class="styleguide-section__title">{{ $t('styleguide.dark.title') }}</h2>
    <p class="styleguide-section__desc">{{ $t('styleguide.dark.desc') }}</p>

    <h3 class="styleguide__group-title">{{ $t('styleguide.dark.toggle') }}</h3>
    <div class="styleguide__component-demo">
      <v-switch
        v-model="darkMode"
        :label="$t(darkMode ? 'styleguide.dark.on' : 'styleguide.dark.off')"
        color="primary"
        @update:model-value="toggleDark"
      />
      <p class="u-muted" style="margin-top: var(--sp-2);">
        {{ $t('styleguide.dark.persist') }}
      </p>
    </div>

    <h3 class="styleguide__group-title" style="margin-top: var(--sp-8);">{{ $t('styleguide.dark.tokens') }}</h3>
    <div class="styleguide__token-table">
      <table class="u-table">
        <thead>
          <tr>
            <th>{{ $t('styleguide.dark.token') }}</th>
            <th>{{ $t('styleguide.motion.value') }}</th>
            <th>{{ $t('styleguide.dark.light') }}</th>
            <th>{{ $t('styleguide.dark.dark') }}</th>
          </tr>
        </thead>
        <tbody>
          <tr v-for="token in darkTokens" :key="token.name">
            <td><code>{{ token.name }}</code></td>
            <td><code>{{ token.value }}</code></td>
            <td><code>{{ token.light }}</code></td>
            <td><code>{{ token.dark }}</code></td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 class="styleguide__group-title" style="margin-top: var(--sp-8);">{{ $t('styleguide.dark.preview') }}</h3>
    <div class="styleguide__component-demo">
      <v-card class="styleguide__preview-card" :class="{ 'v-theme--dark': darkMode }">
        <v-card-title>{{ $t('styleguide.dark.previewTitle') }}</v-card-title>
        <v-card-text>
          <p>{{ $t('styleguide.dark.previewText') }}</p>
          <v-btn color="primary" variant="flat" class="mr-2">{{ $t('styleguide.components.primary') }}</v-btn>
          <v-btn color="primary" variant="outlined">{{ $t('styleguide.components.outlined') }}</v-btn>
          <v-text-field label="{{ $t('styleguide.components.textField') }}" variant="outlined" class="mt-4" style="max-width: 300px;" />
        </v-card-text>
      </v-card>
    </div>

    <div class="styleguide-section__note">
      {{ $t('styleguide.dark.note') }}
    </div>
  </div>
</template>

<script>
import { ref, computed, watch, onMounted } from 'vue'
import { useVuetify } from 'vuetify'

export default {
  name: 'StyleguideDarkMode',

  setup() {
    const vuetify = useVuetify()
    const darkMode = ref(false)

    const darkTokens = computed(() => [
      { name: '--c-bg', light: 'var(--c-bg)', dark: 'var(--c-bg)' },
      { name: '--c-surface', light: 'var(--c-surface)', dark: 'var(--c-surface)' },
      { name: '--c-primary', light: '#1a5fb4', dark: '#7aa7e8' },
      { name: '--c-accent', light: '#0d9488', dark: '#2dd4bf' },
      { name: '--c-text', light: '#1c2024', dark: '#e8eaed' },
      { name: '--c-border', light: '#dde1e6', dark: '#363c43' },
      { name: '--c-success', light: '#1e7a3c', dark: '#6fce8f' },
      { name: '--c-danger', light: '#b3261e', dark: '#f2857c' },
      { name: '--shadow-1', light: '0 1px 2px...', dark: '0 1px 2px rgba(0,0,0,0.4)' },
    ])

    const toggleDark = (value) => {
      vuetify.theme.global.name.value = value ? 'dark' : 'light'
      localStorage.setItem('theme', value ? 'dark' : 'light')
    }

    onMounted(() => {
      const saved = localStorage.getItem('theme')
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
      const initial = saved ? saved === 'dark' : prefersDark
      darkMode.value = initial
      vuetify.theme.global.name.value = initial ? 'dark' : 'light'
    })

    return { darkMode }
  },
}