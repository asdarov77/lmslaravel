<template>
  <div class="styleguide-section">
    <h2 class="styleguide-section__title">{{ $t('styleguide.typography.title') }}</h2>
    <p class="styleguide-section__desc">{{ $t('styleguide.typography.desc') }}</p>

    <div class="styleguide__type-scales">
      <h3 class="styleguide__group-title">{{ $t('styleguide.typography.scaleTitle') }}</h3>
      <div class="styleguide__type-scale">
        <div
          v-for="item in typeScale"
          :key="item.name"
          class="styleguide__type-item"
        >
          <span class="styleguide__type-name">{{ item.name }}</span>
          <span class="styleguide__type-token" :style="{ fontSize: item.value }">{{ item.token }}</span>
          <div class="styleguide__type-sample" :style="{ fontSize: item.value }">
            {{ item.sample }}
          </div>
        </div>
      </div>
    </div>

    <h3 class="styleguide__group-title" style="margin-top: var(--sp-8);">{{ $t('styleguide.typography.weights') }}</h3>
    <div class="styleguide__weights">
      <div
        v-for="weight in weights"
        :key="weight.name"
        class="styleguide__weight-item"
      >
        <span class="styleguide__weight-name">{{ weight.name }}</span>
        <span class="styleguide__weight-sample" :style="{ fontWeight: weight.value }">
          {{ weight.sample }}
        </span>
      </div>
    </div>

    <h3 class="styleguide__group-title" style="margin-top: var(--sp-8);">{{ $t('styleguide.typography.families') }}</h3>
    <div class="styleguide__families">
      <div
        v-for="family in families"
        :key="family.name"
        class="styleguide__family-item"
      >
        <span class="styleguide__family-name">{{ family.name }}</span>
        <span class="styleguide__family-sample" :style="{ fontFamily: family.value }">
          {{ family.sample }}
        </span>
      </div>
    </div>

    <div class="styleguide-section__note">
      {{ $t('styleguide.typography.note') }}
    </div>
  </div>
</template>

<script>
import { computed } from 'vue'
import { useI18n } from 'vue-i18n'

export default {
  name: 'StyleguideTypography',

  setup() {
    const { t } = useI18n()

    const typeScale = computed(() => [
      { name: t('styleguide.typography.fs2xs'), token: '--fs-2xs', value: 'var(--fs-2xs)', sample: '11px' },
      { name: t('styleguide.typography.fsxs'), token: '--fs-xs', value: 'var(--fs-xs)', sample: '12px' },
      { name: t('styleguide.typography.fssm'), token: '--fs-sm', value: 'var(--fs-sm)', sample: '13px' },
      { name: t('styleguide.typography.fsbase'), token: '--fs-base', value: 'var(--fs-base)', sample: '15px' },
      { name: t('styleguide.typography.fsmd'), token: '--fs-md', value: 'var(--fs-md)', sample: '16px' },
      { name: t('styleguide.typography.fslg'), token: '--fs-lg', value: 'var(--fs-lg)', sample: '18px' },
      { name: t('styleguide.typography.fsxl'), token: '--fs-xl', value: 'var(--fs-xl)', sample: '20px' },
      { name: t('styleguide.typography.fs2xl'), token: '--fs-2xl', value: 'var(--fs-2xl)', sample: '24px' },
      { name: t('styleguide.typography.fs3xl'), token: '--fs-3xl', value: 'var(--fs-3xl)', sample: '30px' },
    ])

    const weights = computed(() => [
      { name: t('styleguide.typography.regular'), value: '400', sample: 'Regular' },
      { name: t('styleguide.typography.medium'), value: '500', sample: 'Medium' },
      { name: t('styleguide.typography.semibold'), value: '600', sample: 'Semi Bold' },
      { name: t('styleguide.typography.bold'), value: '700', sample: 'Bold' },
    ])

    const families = computed(() => [
      { name: t('styleguide.typography.main'), value: 'var(--font-family)', sample: 'Inter / System UI' },
      { name: t('styleguide.typography.mono'), value: 'var(--font-mono)', sample: 'Monospace' },
    ])

    return { typeScale, weights, families }
  },
}
</script>

<style scoped>
.styleguide__type-scales {
  display: flex;
  flex-direction: column;
  gap: var(--sp-6);
}

.styleguide__type-item {
  display: flex;
  align-items: baseline;
  gap: var(--sp-4);
  padding: var(--sp-3);
  background: var(--c-surface);
  border: 1px solid var(--c-border);
  border-radius: var(--c-radius-md);
}

.styleguide__type-name {
  font-size: var(--fs-sm);
  font-weight: 500;
  color: var(--c-text);
  min-width: 80px;
}

.styleguide__type-token {
  font-size: var(--fs-xs);
  color: var(--c-primary);
  font-family: var(--font-mono);
  min-width: 100px;
}

.styleguide__type-sample {
  flex: 1;
  padding: var(--sp-2) var(--sp-3);
  background: var(--c-surface-2);
  border-radius: var(--c-radius-sm);
}

.styleguide__weights {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}

.styleguide__weight-item {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  padding: var(--sp-3);
  background: var(--c-surface);
  border: 1px solid var(--c-border);
  border-radius: var(--c-radius-md);
}

.styleguide__weight-name {
  font-size: var(--fs-sm);
  font-weight: 500;
  color: var(--c-text);
  min-width: 120px;
}

.styleguide__weight-sample {
  font-size: var(--fs-base);
}

.styleguide__families {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}

.styleguide__family-item {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  padding: var(--sp-3);
  background: var(--c-surface);
  border: 1px solid var(--c-border);
  border-radius: var(--c-radius-md);
}

.styleguide__family-name {
  font-size: var(--fs-sm);
  font-weight: 500;
  color: var(--c-text);
  min-width: 120px;
}

.styleguide__family-sample {
  font-size: var(--fs-base);
  flex: 1;
}
</style>