<template>
  <div class="styleguide-section">
    <h2 class="styleguide-section__title">{{ $t('styleguide.motion.title') }}</h2>
    <p class="styleguide-section__desc">{{ $t('styleguide.motion.desc') }}</p>

    <h3 class="styleguide__group-title">{{ $t('styleguide.motion.tokens') }}</h3>
    <div class="styleguide__token-table">
      <table class="u-table">
        <thead>
          <tr>
            <th>{{ $t('styleguide.motion.token') }}</th>
            <th>{{ $t('styleguide.motion.value') }}</th>
            <th>{{ $t('styleguide.motion.description') }}</th>
          </tr>
        </thead>
        <tbody>
          <tr v-for="token in motionTokens" :key="token.name">
            <td><code>{{ token.name }}</code></td>
            <td><code>{{ token.value }}</code></td>
            <td>{{ token.desc }}</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 class="styleguide__group-title" style="margin-top: var(--sp-8);">{{ $t('styleguide.motion.pageTransitions') }}</h3>
    <div class="styleguide__component-demo">
      <div>
        <div class="styleguide__page-preview" :key="previewPage">
          <h3>{{ $t('styleguide.motion.pageTitle') }} {{ previewPage }}</h3>
          <p>{{ $t('styleguide.motion.pageDesc') }}</p>
          <v-btn @click="nextPage">{{ $t('styleguide.motion.nextPage') }}</v-btn>
        </div>
      </div>
    </div>

    <h3 class="styleguide__group-title" style="margin-top: var(--sp-8);">{{ $t('styleguide.motion.stagger') }}</h3>
    <div class="styleguide__component-demo">
      <ul data-stagger class="styleguide__stagger-list">
        <li v-for="i in 5" :key="i">{{ $t('styleguide.motion.item', { n: i }) }}</li>
      </ul>
      <v-btn @click="rerenderStagger" style="margin-top: var(--sp-4);">
        {{ $t('styleguide.motion.rerun') }}
      </v-btn>
    </div>

    <h3 class="styleguide__group-title" style="margin-top: var(--sp-8);">{{ $t('styleguide.motion.reducedMotion') }}</h3>
    <div class="styleguide__component-demo">
      <p>{{ $t('styleguide.motion.reducedDesc') }}</p>
      <v-switch
        v-model="forceReduced"
        :label="$t('styleguide.motion.forceReduced')"
        color="primary">
      </v-switch>
      <p class="u-muted" style="margin-top: var(--sp-2);">
        {{ $t('styleguide.motion.systemSetting') }}
        <code>prefers-reduced-motion: reduce</code>
      </p>
    </div>

    <h3 class="styleguide__group-title" style="margin-top: var(--sp-8);">{{ $t('styleguide.motion.slideToggle') }}</h3>
    <div class="styleguide__component-demo">
      <v-switch v-model="slideOpen" :label="$t('styleguide.motion.toggleLabel')" color="primary">
      </v-switch>
      <div
        v-show="slideOpen"
        style="height: 120px; background: var(--c-primary-soft); margin-top: var(--sp-3); border-radius: var(--c-radius-md); overflow: hidden;"
        ref="slideEl"
      >
        <p class="pa-4">{{ $t('styleguide.motion.slideContent') }}</p>
      </div>
    </div>
  </div>
</template>

<script>
import { ref, onMounted } from 'vue'
import PageTransition from '../../components/ui/PageTransition.vue'

export default {
  name: 'StyleguideMotion',

  components: { PageTransition },

  setup() {
    const previewPage = ref(1)
    const forceReduced = ref(false)
    const slideOpen = ref(false)

    const nextPage = () => {
      previewPage.value = previewPage.value === 1 ? 2 : 1
    }

    const rerenderStagger = () => {
      // Force re-render by toggling a key or similar
      // In real usage, the list data would change
    }

    return { nextPage, rerenderStagger }
  },
}